# Gateway env. Copy to .env (gitignored). No VITE_ names: nothing here may reach the browser bundle.
# URLs: http(s)://host[:port], no trailing slash.
PROXMOX_BACKEND_URL=
UPTIME_KUMA_BACKEND_URL=
UPDATES_BACKEND_URL=
# Read-only Proxmox API token (see README: Security model). Values may not contain spaces, quotes, $, ; { }
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
