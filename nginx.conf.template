server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/proxmox/ {
        # proxy_ssl_verify off is needed if your proxmox uses a self-signed cert
        proxy_pass ${VITE_PROXMOX_URL}/;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }

    location /api/portainer/ {
        proxy_pass ${VITE_PORTAINER_URL}/;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }

    location /api/uptime/ {
        proxy_pass ${VITE_UPTIME_KUMA_URL}/;
        proxy_set_header Host $host;
        # Support websockets for uptime kuma
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /api/jellyfin/ {
        proxy_pass https://jellyfin.charlesterrenal.com/;
        proxy_ssl_server_name on;
    }

    location /api/tailscale/ {
        proxy_pass https://api.tailscale.com/;
        proxy_ssl_server_name on;
    }

    location /api/todoist/ {
        proxy_pass https://api.todoist.com/;
        proxy_ssl_server_name on;
    }

    location /api/qbit/ {
        proxy_pass http://192.168.254.203:8080/;
        proxy_set_header Host $host;
        proxy_set_header Origin http://192.168.254.203:8080;
        proxy_set_header Referer http://192.168.254.203:8080/;
    }

    location /api/radarr/ {
        proxy_pass http://192.168.254.203:7878/;
        proxy_set_header Host $host;
    }

    location /api/sonarr/ {
        proxy_pass http://192.168.254.203:8989/;
        proxy_set_header Host $host;
    }

    location /api/jellyseerr/ {
        proxy_pass http://192.168.254.203:5055/;
        proxy_set_header Host $host;
    }
}
