server {
    listen 80;
    server_name localhost;
    server_tokens off;
    root /usr/share/nginx/html;

    # Security headers (server level; inherited by every location below because none sets its own add_header).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    # No integration needs upstream cookies under the dashboard origin.
    proxy_hide_header Set-Cookie;

    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Runtime config mounted by compose. 404 when absent (never the SPA fallback).
    # No add_header here: it would drop the server-level security headers.
    location = /config/services.json {
        try_files $uri =404;
        expires -1;
    }

    # Every /api/ path not explicitly allowed below. Exact (=) and regex locations take precedence over this prefix.
    location /api/ {
        default_type application/json;
        return 404 '{"error":"not found"}';
    }

    # Allowlist: exactly the requests the frontend makes. GET only (limit_except GET also permits HEAD).
    # nginx does not inherit proxy_set_header once a location sets any, so each location lists all of its own.

    # --- Proxmox VE: the only credential, a read-only token injected here ---
    # Regex locations cannot carry a URI in proxy_pass, so rewrite and proxy_pass the bare backend URL (no trailing "/").
    location ~ ^/api/proxmox/nodes/[A-Za-z0-9-]+/(status|storage|lxc)$ {
        limit_except GET { deny all; }
        rewrite ^/api/proxmox/(.*)$ /api2/json/$1 break;
        proxy_pass ${PROXMOX_BACKEND_URL};
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header Authorization "PVEAPIToken=${PVE_TOKEN_ID}=${PVE_TOKEN_SECRET}";
    }

    # --- Uptime Kuma (public status page only) ---
    location = /api/uptime/api/status-page/default {
        limit_except GET { deny all; }
        proxy_pass ${UPTIME_KUMA_BACKEND_URL}/api/status-page/default;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }
    location = /api/uptime/api/status-page/heartbeat/default {
        limit_except GET { deny all; }
        proxy_pass ${UPTIME_KUMA_BACKEND_URL}/api/status-page/heartbeat/default;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }

    # --- Update status (Proxmox host, port 8199) ---
    location = /api/updates/status.json {
        limit_except GET { deny all; }
        proxy_pass ${UPDATES_BACKEND_URL}/status.json;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }
    location = /api/updates/containers.json {
        limit_except GET { deny all; }
        proxy_pass ${UPDATES_BACKEND_URL}/containers.json;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }
}
